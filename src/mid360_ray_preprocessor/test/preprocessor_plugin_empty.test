<?xml version="1.0"?>
<launch>
  <include file="$(find livox_laser_simulation)/launch/ray_bundle_test.launch">
    <arg name="world"
         value="$(find livox_laser_simulation)/worlds/ray_bundle_empty.world"/>
    <arg name="scenario" value="empty"/>
    <arg name="run_validator" value="false"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
  </include>

  <node pkg="tf2_ros" type="static_transform_publisher"
        name="preprocessor_plugin_empty_tf"
        args="0 0 0 0 0 0 1 world uav1/mid360"/>

  <node pkg="mid360_ray_preprocessor"
        type="mid360_ray_preprocessor_node"
        name="preprocessor_plugin_empty_node"
        output="screen">
    <rosparam command="load" file="$(find mid360_ray_preprocessor)/config/default.yaml"/>
    <param name="ray_time_geometry_mode" value="snapshot"/>
    <param name="output_frame" value="world"/>
  </node>

  <test test-name="preprocessor_plugin_empty_contract"
        pkg="mid360_ray_preprocessor"
        type="preprocessor_plugin_integration_test.py"
        time-limit="35">
    <param name="mode" value="empty"/>
    <param name="required_pairs" value="2"/>
    <param name="timeout_sec" value="28.0"/>
  </test>
</launch>
