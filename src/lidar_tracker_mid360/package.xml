<?xml version="1.0"?>
<package format="2">
  <name>lidar_tracker_mid360</name>
  <version>1.0.0</version>
  <description>Controlled Mid-360 CTU-MRS LiDAR tracker baseline with a paired-frame completion contract.</description>

  <maintainer email="vrbamato@fel.cvut.cz">Matous Vrba</maintainer>
  <author email="vrbamato@fel.cvut.cz">Matous Vrba</author>
  <author email="pliskmic@fel.cvut.cz">Michal Pliska</author>
  <author email="kratot13@fel.cvut.cz">Tomas Kratochvil</author>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>dynamic_reconfigure</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>message_generation</depend>
  <depend>message_runtime</depend>
  <depend>mrs_lib</depend>
  <depend>mrs_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nodelet</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vofod_mid360</depend>

  <test_depend>rostest</test_depend>
  <test_depend>rosgraph</test_depend>
  <test_depend>rospy</test_depend>

  <export>
    <nodelet plugin="${prefix}/plugins.xml"/>
  </export>
</package>
