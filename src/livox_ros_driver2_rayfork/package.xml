<?xml version="1.0"?>
<package format="2">
  <name>livox_ros_driver2</name>
  <version>1.2.5</version>
  <description>Controlled ROS1 Livox driver2 fork with optional raw spherical RayBundle output.</description>
  <maintainer email="dev@livoxtech.com">Livox Dev Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>mid360_ray_msgs</depend>
  <depend>rosbag</depend>
  <depend>pcl_ros</depend>
  <depend>git</depend>
  <depend>apr</depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
</package>
