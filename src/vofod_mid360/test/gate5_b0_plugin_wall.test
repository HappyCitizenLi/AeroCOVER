<?xml version="1.0"?>
<launch>
  <include file="$(find vofod_mid360)/launch/gate5_plugin_fixture_b0.launch">
    <arg name="world"
         value="$(find livox_laser_simulation)/worlds/ray_bundle_single_wall.world"/>
    <arg name="scenario" value="wall"/>
  </include>

  <test test-name="gate5_b0_plugin_wall_contract"
        pkg="vofod_mid360"
        type="gate5_b0_plugin_fixture_test.py"
        time-limit="45">
    <param name="mode" value="wall"/>
    <param name="timeout_wall_sec" value="35.0"/>
    <param name="required_scans" value="10"/>
  </test>
</launch>
