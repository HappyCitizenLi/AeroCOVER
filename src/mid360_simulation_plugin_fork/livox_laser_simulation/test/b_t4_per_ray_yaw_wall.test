<?xml version="1.0"?>
<launch>
  <include file="$(find livox_laser_simulation)/launch/b_t4_per_ray_wall_test.launch">
    <arg name="motion_case" value="yaw"/>
    <arg name="run_validator" value="false"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
  </include>

  <test test-name="b_t4_per_ray_yaw_wall"
        pkg="livox_laser_simulation"
        type="b_t4_per_ray_wall_validator.py"
        time-limit="60">
    <param name="rostest" value="true"/>
    <param name="motion_case" value="yaw"/>
    <param name="model_name" value="mid360_b_t4_per_ray_observer"/>
    <param name="desired_yaw_rate_radps" value="1.0"/>
    <param name="required_bundles" value="3"/>
    <param name="timeout_sec" value="45"/>
  </test>
</launch>
