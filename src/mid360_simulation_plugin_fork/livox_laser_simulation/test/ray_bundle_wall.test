<?xml version="1.0"?>
<launch>
  <include file="$(find livox_laser_simulation)/launch/ray_bundle_test.launch">
    <arg name="world"
         value="$(find livox_laser_simulation)/worlds/ray_bundle_single_wall.world"/>
    <arg name="scenario" value="wall"/>
    <arg name="run_validator" value="false"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
  </include>

  <test test-name="ray_bundle_wall"
        pkg="livox_laser_simulation"
        type="ray_bundle_validator.py"
        time-limit="25.0">
    <param name="mode" value="wall"/>
    <param name="rostest" value="true"/>
    <param name="ray_topic" value="/uav1/mid360/rays_raw"/>
    <param name="point_topic" value="/uav1/mid360/points_raw"/>
    <param name="diagnostics_topic" value="/uav1/mid360/ray_source_diagnostics"/>
    <param name="expected_frame" value="uav1/mid360"/>
    <param name="samples" value="20000"/>
    <param name="downsample" value="1"/>
    <param name="pattern_step" value="1"/>
    <param name="required_bundles" value="3"/>
    <param name="timeout_sec" value="20.0"/>
    <param name="require_pattern_wrap" value="true"/>
    <param name="csv_file"
           value="$(find livox_laser_simulation)/scan_mode/mid360-real-centr.csv"/>
  </test>
</launch>
