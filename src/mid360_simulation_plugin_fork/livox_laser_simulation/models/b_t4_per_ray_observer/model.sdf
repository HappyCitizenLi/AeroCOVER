<?xml version="1.0"?>
<sdf version="1.6">
  <model name="mid360_b_t4_per_ray_observer">
    <!-- Dynamic even in the stationary test so the two cases exercise the same
         Gazebo link and differ only in the commanded world angular velocity. -->
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- Deliberately collision-free.  The only externally visible return in
         the test world must come from the declared static wall. -->
    <link name="mid360_link">
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay>
        <linear>0</linear>
        <angular>0</angular>
      </velocity_decay>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.0008</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0008</iyy>
          <iyz>0</iyz>
          <izz>0.0008</izz>
        </inertia>
      </inertial>

      <sensor name="mid360_b_t4_ray_sensor" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>

        <plugin name="mid360_b_t4_per_ray_plugin"
                filename="liblivox_laser_simulation.so">
          <ray>
            <scan>
              <horizontal>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
              <vertical>
                <samples>50</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>40.0</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0</stddev>
            </noise>
          </ray>

          <robotNamespace>/</robotNamespace>
          <parentFrameName>b_t4/observer</parentFrameName>
          <frameName>b_t4/mid360</frameName>
          <ros_topic>/b_t4/mid360/points_raw</ros_topic>
          <publish_ray_bundle>true</publish_ray_bundle>
          <ray_bundle_topic>/b_t4/mid360/rays_raw</ray_bundle_topic>
          <ray_bundle_frame>b_t4/mid360</ray_bundle_frame>
          <ray_diagnostics_topic>/b_t4/mid360/ray_source_diagnostics</ray_diagnostics_topic>

          <samples>20000</samples>
          <downsample>1</downsample>
          <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <publish_pointcloud_type>2</publish_pointcloud_type>
          <!-- The bundled CSV contains sample ordinals rather than seconds.
               Make the tested 200 kpoint/s timing contract explicit. -->
          <use_csv_time>false</use_csv_time>
          <ray_point_rate>200000</ray_point_rate>

          <ray_time_geometry_mode>per_ray_pose</ray_time_geometry_mode>
          <per_ray_pose_static_scene_opt_in>true</per_ray_pose_static_scene_opt_in>
        </plugin>
      </sensor>
    </link>

    <!-- Independent, timestamped Gazebo link truth.  The validator strictly
         brackets every ray time with this stream; it does not consume TF or a
         pose generated from the plugin under test. -->
    <plugin name="mid360_b_t4_link_truth" filename="libgazebo_ros_p3d.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>250</updateRate>
      <bodyName>mid360_link</bodyName>
      <topicName>/b_t4/observer/odom</topicName>
      <frameName>world</frameName>
      <localTwist>false</localTwist>
      <gaussianNoise>0</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
    </plugin>
  </model>
</sdf>
