<?xml version="1.0"?>
<sdf version="1.6">
  <model name="mid360_ray_bundle_test_sensor">
    <static>true</static>

    <!-- Deliberately no link collision: the empty-world test must have no target
         geometry that can return a range. The plugin creates its own multiray
         collision internally. -->
    <link name="mid360_link">
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <sensor name="mid360_ray_sensor" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>

        <plugin name="mid360_ray_bundle_test_plugin"
                filename="liblivox_laser_simulation.so">
          <ray>
            <scan>
              <horizontal>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
              <vertical>
                <samples>50</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>40.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </ray>

          <robotNamespace>/</robotNamespace>
          <parentFrameName>world</parentFrameName>
          <frameName>uav1/mid360</frameName>
          <visualize>false</visualize>

          <!-- Exercise the production-rate 20,000-ray bundle without dropping
               any emitted pattern sample. -->
          <samples>20000</samples>
          <downsample>1</downsample>
          <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <publish_pointcloud_type>2</publish_pointcloud_type>
          <ros_topic>/uav1/mid360/points_raw</ros_topic>

          <publish_ray_bundle>true</publish_ray_bundle>
          <ray_bundle_topic>/uav1/mid360/rays_raw</ray_bundle_topic>
          <ray_bundle_frame>uav1/mid360</ray_bundle_frame>
          <!-- Source diagnostics are kept separate from the checked/preprocessor
               diagnostics published on /uav1/mid360/ray_diagnostics. -->
          <ray_diagnostics_topic>/uav1/mid360/ray_source_diagnostics</ray_diagnostics_topic>
          <use_csv_time>true</use_csv_time>
          <ray_point_rate>200000</ray_point_rate>
          <ray_time_geometry_mode>snapshot</ray_time_geometry_mode>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
