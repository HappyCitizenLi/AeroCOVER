<?xml version="1.0"?>
<sdf version="1.6">
  <world name="b_t4_per_ray_static_wall">
    <gravity>0 0 0</gravity>
    <physics name="b_t4_ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.2 0.2 0.2 1</ambient>
      <background>0.04 0.04 0.04 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- This is the world's only collision.  The face visible from the origin
         is exactly x=12 m; large finite bounds still leave many NO_RETURN rays
         while providing thousands of unambiguous interior hits per bundle. -->
    <model name="b_t4_static_wall">
      <static>true</static>
      <pose>12.1 0 0 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>0.2 40 20</size></box>
          </geometry>
          <surface>
            <contact><collide_without_contact>true</collide_without_contact></contact>
          </surface>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>0.2 40 20</size></box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.68 1</ambient>
            <diffuse>0.75 0.75 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
