<?xml version="1.0"?>
<sdf version="1.6">
  <world name="E4_long_occlusion">
    <gravity>0 0 -9.80665</gravity>
    <physics name="ode_1khz" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.65 0.78 0.92 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <include>
      <uri>model://mid360_open_ground</uri>
      <name>open_ground</name>
    </include>

    <!-- Wide enough to hide the complete UAV primitive, including rotors. -->
    <model name="background_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="wall_collision">
          <pose>10 0 3 0 0 0</pose>
          <geometry><box><size>0.50 3.00 6.00</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <pose>10 0 3 0 0 0</pose>
          <geometry><box><size>0.50 3.00 6.00</size></box></geometry>
          <material>
            <ambient>0.34 0.36 0.40 1</ambient>
            <diffuse>0.48 0.51 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://pillar</uri>
      <name>pillar</name>
      <pose>7 -6 0 0 0 0</pose>
    </include>
  </world>
</sdf>
