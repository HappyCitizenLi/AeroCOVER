<?xml version="1.0"?>
<sdf version="1.6">
  <world name="E3_cluttered">
    <gravity>0 0 -9.80665</gravity>
    <physics name="ode_1khz" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.32 0.32 0.32 1</ambient>
      <background>0.60 0.72 0.84 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <include>
      <uri>model://mid360_open_ground</uri>
      <name>clutter_ground</name>
    </include>

    <include>
      <uri>model://gate_frame</uri>
      <name>gate_frame_near</name>
      <pose>1 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://gate_frame</uri>
      <name>gate_frame_far</name>
      <pose>8 1 0 0 0 0.5</pose>
    </include>

    <include>
      <uri>model://pillar</uri>
      <name>clutter_pillar_southwest</name>
      <pose>2.5 -4 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pillar</uri>
      <name>clutter_pillar_center</name>
      <pose>5 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pillar</uri>
      <name>clutter_pillar_northeast</name>
      <pose>8 3.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pillar</uri>
      <name>clutter_pillar_southeast</name>
      <pose>11 -3.5 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://sparse_wide_wall</uri>
      <name>clutter_wall_east</name>
      <pose>18 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://sparse_wide_wall</uri>
      <name>clutter_wall_north</name>
      <pose>4 8 0 0 0 1.5707963267948966</pose>
    </include>
    <include>
      <uri>model://sparse_wide_wall</uri>
      <name>clutter_wall_south</name>
      <pose>4 -8 0 0 0 1.5707963267948966</pose>
    </include>

    <!-- Observer and all five targets are spawned only by gate_s05.launch. -->
  </world>
</sdf>
