<?xml version="1.0"?>
<launch>
  <arg name="gui" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="verbose" default="false"/>
  <arg name="run_preprocessor" default="true"/>
  <arg name="run_scenario_manager" default="true"/>
  <arg name="scenario_config"
       default="$(find mid360_multi_uav_sim)/config/scenarios/S02.yaml"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"
         value="$(find mid360_multi_uav_sim)/worlds/E0_open.world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="true"/>
    <arg name="verbose" value="$(arg verbose)"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav1_observer" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/observer_uav/model.sdf -model uav1 -robot_namespace /uav1 -x 0 -y 0 -z 2.0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav2_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav2 -x 7.132923872 -y -2.317627458 -z 3.150 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav3_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav3 -x 4.408389392 -y 6.067627458 -z 3.150 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav4_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav4 -x -4.408389392 -y 6.067627458 -z 3.150 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav5_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav5 -x -7.132923872 -y -2.317627458 -z 3.150 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav6_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav6 -x 0 -y -7.500000000 -z 3.150 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav7_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav7 -x 9.177695382 -y 2.982013996 -z 3.408 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav8_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav8 -x 0 -y 9.650000000 -z 3.408 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav9_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav9 -x -9.177695382 -y 2.982013996 -z 3.408 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav10_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav10 -x -5.672127685 -y -7.807013996 -z 3.408 -Y 0"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_uav11_target" output="screen"
        args="-sdf -file $(find mid360_multi_uav_sim)/models/simplified_target_uav/model.sdf -model uav11 -x 5.672127685 -y -7.807013996 -z 3.408 -Y 0"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_uav1_fcu"
        args="0 0 2.0 0 0 0 1 world uav1/fcu"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="uav1_fcu_to_mid360"
        args="0 0 0.25 0 0 0 1 uav1/fcu uav1/mid360_link"/>

  <include if="$(arg run_preprocessor)"
           file="$(find mid360_ray_preprocessor)/launch/preprocessor.launch">
    <arg name="ray_time_geometry_mode" value="snapshot"/>
    <arg name="output_frame" value="world"/>
  </include>

  <node if="$(arg run_scenario_manager)" pkg="mid360_multi_uav_sim"
        type="scenario_manager.py" name="scenario_manager" output="screen">
    <param name="scenario_file" value="$(arg scenario_config)"/>
  </node>
</launch>
