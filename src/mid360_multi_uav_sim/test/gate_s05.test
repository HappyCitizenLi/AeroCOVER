<?xml version="1.0"?>
<launch>
  <include file="$(find mid360_multi_uav_sim)/launch/gate_s05.launch">
    <arg name="gui" value="false"/>
    <arg name="verbose" value="false"/>
    <arg name="run_preprocessor" value="true"/>
    <arg name="run_scenario_manager" value="true"/>
  </include>

  <test test-name="gate_s05_contract"
        pkg="mid360_multi_uav_sim"
        type="gate_s05_test.py"
        time-limit="240">
    <param name="timeout_wall_sec" value="220.0"/>
    <param name="post_complete_timeout_wall_sec" value="12.0"/>
    <param name="expected_ray_count" value="20000"/>
    <param name="maximum_tf_gap_sec" value="0.20"/>
    <param name="minimum_scored_translation_m" value="5.0"/>
    <param name="minimum_scored_yaw_rad" value="0.70"/>
    <param name="minimum_scored_bundles" value="3"/>
    <param name="maximum_geometry_scans" value="8"/>
    <param name="minimum_geometry_scans" value="3"/>
    <param name="minimum_gate_hit_count" value="5"/>
    <param name="minimum_pillar_hit_count" value="5"/>
    <param name="minimum_wide_wall_hit_count" value="5"/>
    <param name="geometry_tolerance_m" value="0.04"/>
    <param name="minimum_bundle_translation_m" value="0.060"/>
    <param name="maximum_bundle_translation_m" value="0.080"/>
    <param name="minimum_bundle_yaw_rad" value="0.007"/>
    <param name="maximum_bundle_yaw_rad" value="0.012"/>
  </test>
</launch>
