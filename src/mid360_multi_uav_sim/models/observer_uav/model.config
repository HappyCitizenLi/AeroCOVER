<?xml version="1.0"?>
<model>
  <name>UAV1 Mid360 Lightweight Observer</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>mid360_multi_uav_sim</name>
