<?xml version="1.0"?>
<sdf version="1.6">
  <model name="observer_rangefinder">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="sensor_link">
      <kinematic>true</kinematic>
      <gravity>false</gravity>
      <sensor name="downward_ray" type="ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>30</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples><resolution>1</resolution>
              <min_angle>-0.015</min_angle><max_angle>0.015</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples><resolution>1</resolution>
              <min_angle>-0.015</min_angle><max_angle>0.015</max_angle>
            </vertical>
          </scan>
          <range><min>0.10</min><max>36.0</max><resolution>0.005</resolution></range>
        </ray>
        <plugin name="range_publisher" filename="libMrsGazeboCommonResources_RangefinderPlugin.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30</updateRate>
          <topicName>/uav1/native_rangefinder</topicName>
          <frameName>uav1/native_rangefinder</frameName>
          <fov>0.03</fov>
          <radiation>infrared</radiation>
          <gaussianNoise>0.01</gaussianNoise>
          <!-- Match rangefinder_follower.py and benchmark.launch. The plugin
               publishes these extrinsics on /tf_gazebo_static; world/identity
               would overwrite the correct mount in worlds with a TF relay. -->
          <parentFrameName>uav1/fcu</parentFrameName>
          <x>0</x><y>0.0625</y><z>-0.009</z>
          <roll>1.5707963267948966</roll><pitch>1.5707963267948966</pitch><yaw>0</yaw>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
