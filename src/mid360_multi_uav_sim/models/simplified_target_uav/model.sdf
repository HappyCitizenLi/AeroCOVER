<?xml version="1.0"?>
<sdf version="1.6">
  <model name="simplified_target_uav">
    <!-- Dynamic so a scenario controller can command pose/twist through Gazebo.
         Gravity is disabled to make an uncommanded target hold its initial pose. -->
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <gravity>false</gravity>
      <velocity_decay>
        <linear>0</linear>
        <angular>0</angular>
      </velocity_decay>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.030</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.030</iyy>
          <iyz>0</iyz>
          <izz>0.055</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.50 0.34 0.18</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <collide_without_contact>true</collide_without_contact>
          </contact>
        </surface>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.50 0.34 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.70 0.12 0.08 1</ambient>
          <diffuse>0.90 0.18 0.10 1</diffuse>
        </material>
      </visual>

      <collision name="arm_a_collision">
        <pose>0 0 0 0 0 0.7853981633974483</pose>
        <geometry>
          <box>
            <size>1.00 0.07 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_a_visual">
        <pose>0 0 0 0 0 0.7853981633974483</pose>
        <geometry>
          <box>
            <size>1.00 0.07 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.13 0.13 0.13 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <collision name="arm_b_collision">
        <pose>0 0 0 0 0 -0.7853981633974483</pose>
        <geometry>
          <box>
            <size>1.00 0.07 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="arm_b_visual">
        <pose>0 0 0 0 0 -0.7853981633974483</pose>
        <geometry>
          <box>
            <size>1.00 0.07 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.13 0.13 0.13 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Four thin rotor discs enlarge the ray-visible silhouette while
           retaining primitive, deterministic collision geometry. -->
      <collision name="rotor_fl_collision">
        <pose>0.35 0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
      </collision>
      <visual name="rotor_fl_visual">
        <pose>0.35 0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 0.7</ambient><diffuse>0.12 0.12 0.12 0.7</diffuse></material>
      </visual>

      <collision name="rotor_fr_collision">
        <pose>0.35 -0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
      </collision>
      <visual name="rotor_fr_visual">
        <pose>0.35 -0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 0.7</ambient><diffuse>0.12 0.12 0.12 0.7</diffuse></material>
      </visual>

      <collision name="rotor_rl_collision">
        <pose>-0.35 0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
      </collision>
      <visual name="rotor_rl_visual">
        <pose>-0.35 0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 0.7</ambient><diffuse>0.12 0.12 0.12 0.7</diffuse></material>
      </visual>

      <collision name="rotor_rr_collision">
        <pose>-0.35 -0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
      </collision>
      <visual name="rotor_rr_visual">
        <pose>-0.35 -0.35 0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.17</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 0.7</ambient><diffuse>0.12 0.12 0.12 0.7</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
