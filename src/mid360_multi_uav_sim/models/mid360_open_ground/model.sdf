<?xml version="1.0"?>
<sdf version="1.6">
  <model name="mid360_open_ground">
    <static>true</static>
    <link name="ground_link">
      <collision name="ground_collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="ground_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>160 120</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://mid360_open_ground/materials/scripts</uri>
            <uri>model://cloverleaf_interchange/materials/textures</uri>
            <name>AeroCOVER/Concrete</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
