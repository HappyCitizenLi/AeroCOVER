<?xml version="1.0"?>
<package format="2">
  <name>mid360_ray_preprocessor</name>
  <version>0.1.0</version>
  <description>Index-preserving Mid-360 point filtering and emitted-ray TF preprocessing.</description>

  <maintainer email="uav@todo.todo">uav</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>mid360_ray_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>gtest</test_depend>
  <test_depend>rostest</test_depend>
  <exec_depend>vofod_mid360</exec_depend>
  <test_depend>rospy</test_depend>

  <export/>
</package>
